# Copy to ~/ai-city.env, fill in real values, and always pass it to compose:
#   docker compose --env-file ~/ai-city.env up -d --build      (or scripts/deploy.sh)
# docker compose does NOT read this file by itself - without --env-file every value below is empty.
# Keep the existing project name if this host already runs the stack, or the database volume changes:
#   COMPOSE_PROJECT_NAME=<output of: docker compose ls>

POSTGRES_PASSWORD=change_me_strong_password

GROQ_API_KEY_1=gsk_prod_replace_me_1
GROQ_API_KEY_2=gsk_prod_replace_me_2
GROQ_API_KEY_3=gsk_prod_replace_me_3

ENV=production
LOG_LEVEL=info
